# Copy to .env and edit. docker compose reads this file automatically.

# Public hostname. A DNS A/AAAA record must point at this server before first start,
# otherwise Caddy cannot obtain the Let's Encrypt certificate.
GITLAB_DOMAIN=sub.domain.com

# Email registered with Let's Encrypt (expiry / problem notices).
ACME_EMAIL=admin@domain.com

# Pinned GitLab image tag. Managed by ./upgrade.sh — do not jump versions by hand,
# GitLab requires stopping at specific versions (see README "Upgrading").
GITLAB_VERSION=19.5.1-ce.0

# Host directory for all persistent GitLab data (config, data, logs, backups).
GITLAB_HOME=/srv/gitlab

# Host port for git over SSH (host sshd keeps port 22).
GITLAB_SSH_PORT=2222

# Timezone for GitLab
TZ=UTC
