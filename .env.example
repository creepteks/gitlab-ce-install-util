# Copy to .env and edit. docker compose reads this file automatically.

# Public hostname. A DNS A/AAAA record must point at this server before first start,
# otherwise Caddy cannot obtain the Let's Encrypt certificate.
GITLAB_DOMAIN=sub.domain.com

# Optional: the public IPv4 the domain should point at. Leave empty to auto-detect
# (local interface IPs + outbound IP). Set it when the server is behind NAT, an
# elastic/floating IP, or an outbound proxy/VPN. Several IPs: comma-separated.
PUBLIC_IP=

# Email registered with Let's Encrypt (expiry / problem notices).
ACME_EMAIL=admin@domain.com

# Pinned GitLab image tag. Managed by ./upgrade.sh — do not jump versions by hand,
# GitLab requires stopping at specific versions (see README "Upgrading").
GITLAB_VERSION=19.5.1-ce.0

# Host directory for ALL persistent data: GitLab config/data/logs, Caddy certificates,
# backup bundles. Never change it on a running install (the scripts refuse to start
# GitLab on a different directory than the existing container uses).
GITLAB_HOME=/srv/gitlab

# Host port for git over SSH (host sshd keeps port 22).
GITLAB_SSH_PORT=2222

# Timezone for GitLab
TZ=UTC

# Where backup bundles are written (default: $GITLAB_HOME/bundles). Ideally a
# separate disk or a mounted remote volume. Copy bundles OFF the server anyway.
BACKUP_DIR=

# Automatic bundles kept per kind (daily "scheduled" and "pre-upgrade").
# Manual and migration bundles are never deleted automatically.
BACKUP_KEEP=5
